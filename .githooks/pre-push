#!/bin/sh
# Local push gate: runs the full merge gate (typecheck, lint, unit, terminal
# smoke + BDD on a real isolated opencode host) before anything leaves the
# machine. CI enforces the same checks; this one just fails faster.
# Emergency override: SKIP_GATE=1 git push
if [ "${SKIP_GATE:-0}" = "1" ]; then
  echo "merge-gate: SKIPPED via SKIP_GATE=1 — CI will still enforce everything"
  exit 0
fi
bun run gate || {
  echo "merge-gate: FAILED — fix before pushing (SKIP_GATE=1 git push to override)"
  exit 1
}
